{
  "name": "arlet",
  "version": "0.2.3",
  "license": "GPL-3.0-only",
  "private": true,
  "packageManager": "npm@12.0.2",
  "description": "Unofficial Apple Music client for Windows 10 and 11, built with Tauri v2, Rust, and MusicKit.",
  "keywords": [
    "apple-music",
    "apple-music-client",
    "musickit",
    "music-player",
    "windows",
    "windows-11",
    "desktop-app",
    "tauri",
    "tauri-v2",
    "rust"
  ],
  "homepage": "https://github.com/BurntToasters/Arlet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BurntToasters/Arlet.git"
  },
  "bugs": {
    "url": "https://github.com/BurntToasters/Arlet/issues"
  },
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0",
    "npm": ">=12.0.2"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.js",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "npm run licenses && vitest run --coverage",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml --all-targets",
    "test:e2e": "node scripts/test-e2e.js",
    "test:e2e:app": "node scripts/e2e-app.js",
    "test:e2e:app:real": "dotenv -e .env -- node scripts/e2e-app.js --real-token",
    "test:all": "node scripts/test-all.js",
    "test:scripts": "node --test scripts/*.test.js scripts/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint --max-warnings 0 src/ scripts/ && npm run lint:comments",
    "lint:comments": "node scripts/lint-comments.mjs src src-tauri/src scripts",
    "lint:fix": "eslint src/ scripts/ --fix",
    "format": "prettier --write \"src/**/*.{ts,css,html,json}\" \"scripts/**/*.{js,mjs,cjs,ts,json}\" \".github/workflows/*.{yml,yaml}\" \"*.{json,md,ts}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html,json}\" \"scripts/**/*.{js,mjs,cjs,ts,json}\" \".github/workflows/*.{yml,yaml}\" \"*.{json,md,ts}\"",
    "start": "npm run tauri:dev",
    "tauri": "tauri",
    "tauri:dev": "npm run sync-version && dotenv -e .env -- tauri dev",
    "phase0:preflight": "node scripts/phase0-preflight.js",
    "phase0:mint-token": "node scripts/mint-musickit-token.js",
    "mint": "npm run phase0:mint-token",
    "release:mint-token": "node scripts/mint-musickit-token.js --release",
    "phase0:gate": "node scripts/phase0-preflight.js --require-token && npm run tauri:dev",
    "tauri:build": "npm run sync-version && npm run licenses && dotenv -e .env -- tauri build -- --locked",
    "sync-version": "node scripts/sync-version.js",
    "icons:normalize": "node scripts/normalize-icons.js",
    "licenses": "npm run licenses:npm && npm run licenses:cargo",
    "licenses:npm": "node scripts/generate-npm-licenses.js",
    "licenses:cargo": "node scripts/generate-cargo-licenses.js",
    "release:licenses": "npm run licenses:npm && node scripts/generate-cargo-licenses.js --require-complete",
    "dist:clean": "node scripts/dist-tools.js clean",
    "dist:clean-release-artifacts": "node scripts/dist-tools.js clean-release-artifacts",
    "dist:list": "node scripts/dist-tools.js list",
    "wc": "npm run win-compiler:x64",
    "vi": "node scripts/vi.js",
    "b": "git fetch origin && git switch -C beta origin/beta && npm run vi",
    "r": "git fetch origin && git switch -C main origin/main && npm run vi && npm run gitprune:force",
    "u": "node scripts/npm-safe-update.mjs && node scripts/cargo-safe-update.mjs --manifest-path src-tauri/Cargo.toml && node scripts/sync-version.js",
    "win-compiler:x64": "powershell -NoProfile -ExecutionPolicy Bypass -NoExit -File scripts/launch-vs-devshell.ps1 -Arch x64",
    "win-compiler:arm64": "powershell -NoProfile -ExecutionPolicy Bypass -NoExit -File scripts/launch-vs-devshell.ps1 -Arch arm64",
    "setup:win:artifact-signing": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows-artifact-signing.ps1",
    "build:win:x64:prepared": "dotenv -e .env -- node scripts/tauri-windows-build.js --target x86_64-pc-windows-msvc --bundles nsis",
    "build:win:arm64:prepared": "dotenv -e .env -- node scripts/tauri-windows-build.js --target aarch64-pc-windows-msvc --bundles nsis",
    "build:win:prepared": "npm run build:win:x64:prepared && npm run build:win:arm64:prepared",
    "build:win:x64": "npm run sync-version && npm run licenses && npm run build:win:x64:prepared",
    "build:win:arm64": "npm run sync-version && npm run licenses && npm run build:win:arm64:prepared",
    "build:win": "npm run sync-version && npm run licenses && npm run build:win:prepared",
    "rust:update": "rustup toolchain install --profile minimal --component cargo,clippy,rustfmt",
    "rust:targets:win": "rustup target add x86_64-pc-windows-msvc aarch64-pc-windows-msvc",
    "workspace:bootstrap": "npm run rust:update && npm ci --ignore-scripts && npm run sync-version",
    "workspace:prepare": "npm run workspace:bootstrap && npm run test:all -- --require-clean-proof",
    "release:prepare": "npm run workspace:bootstrap && npm run test:all -- --require-clean-proof && npm run dist:clean-release-artifacts",
    "release:session:verify": "node scripts/release-session.js",
    "release:draft": "dotenv -e .env -- node scripts/ensure-draft-release.cjs",
    "release:publish": "dotenv -e .env -- node scripts/publish-release.cjs",
    "release:wait-draft": "dotenv -e .env -- node scripts/wait-for-draft-release.cjs",
    "release:preflight": "node scripts/release-preflight.js",
    "prerelease:prepare": "node scripts/release-warning.js && npm run release:mint-token && dotenv -e .env -- npm run release:preflight && npm run release:licenses",
    "release:sign:gpg": "dotenv -e .env -- node scripts/gpg-sign.js",
    "release:sync-beta-manifests": "dotenv -e .env -- node scripts/gpg-sign.js --sync-beta-manifests",
    "release:mirror": "dotenv -e .env -- node scripts/finalize-release-assets.js",
    "release:finalize": "npm run release:mirror && node scripts/finalize-reset.js",
    "release:updater-manifests": "dotenv -e .env -- node scripts/generate-updater-manifests.js",
    "validate:updater": "node scripts/validate-updater-manifest.js",
    "release:verify:draft": "dotenv -e .env -- node scripts/verify-release-draft.js",
    "release:verify:published": "dotenv -e .env -- node scripts/verify-release-published.js",
    "release:win:continue": "npm run release:session:verify && npm run release:licenses && npm run release:draft && npm run rust:targets:win && npm run build:win:prepared && npm run release:updater-manifests && npm run release:sign:gpg && npm run release:finalize && npm run release:verify:draft",
    "release:win:resume": "npm run prerelease:prepare && npm run release:win:continue",
    "release:win": "node scripts/run-release.js win",
    "gitprune": "git remote prune origin",
    "gitprune:force": "git fetch --prune origin"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-updater": "^2.13.1",
    "lucide-preact": "^1.52.0",
    "preact": "^10.29.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.1",
    "@types/node": "^24.19.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "@vitest/coverage-v8": "^4.1.11",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "jsdom": "^27.4.0",
    "license-checker-rseidelsohn": "^4.4.2",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
