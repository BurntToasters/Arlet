{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arlet",
  "version": "0.1.0",
  "identifier": "run.rosie.arlet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Arlet",
        "width": 1000,
        "height": 700,
        "minWidth": 640,
        "minHeight": 480,
        "resizable": true,
        "visible": true,
        "transparent": true,
        "titleBarStyle": "Overlay"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://js-cdn.music.apple.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://*.mzstatic.com https://*.apple.com; font-src 'self' data:; connect-src 'self' https://*.apple.com https://*.mzstatic.com; media-src 'self' blob: https://*.apple.com https://*.mzstatic.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'; frame-src https://authorize.music.apple.com; worker-src 'self' blob:",
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/BurntToasters/Arlet/releases/latest/download/latest-{{target}}-{{arch}}.json",
        "https://github.com/BurntToasters/Arlet/releases/latest/download/latest-{{target}}.json",
        "https://github.com/BurntToasters/Arlet/releases/download/v{{current_version}}/latest-{{target}}-{{arch}}.json",
        "https://github.com/BurntToasters/Arlet/releases/download/v{{current_version}}/latest-{{target}}.json"
      ],
      "pubkey": ""
    }
  }
}
