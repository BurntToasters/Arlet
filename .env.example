# Arlet environment
# Copy to .env. Never commit real credentials, private keys, tokens, or passwords.
# Vite `root` is `src/`; `envDir` is this repository root so `.env` loads.

# MusicKit developer token for local `tauri:dev` only (Apple JWT, not a Vite token).
# Generate from your Apple Developer Media Services key; never commit the .p8.
# Loaded by `dotenv -e .env -- tauri dev`. Rust serves it to MusicKit in debug
# builds only. Production uses a token service, not this variable.
# Not required for the unprivileged music.apple.com diagnostic webview.
#
# Optional mint inputs for `npm run phase0:mint-token`. The .p8 path must be
# absolute and outside this repository. The script writes MUSICKIT_DEVELOPER_TOKEN
# and never prints the JWT or private key.
MUSICKIT_TEAM_ID=
MUSICKIT_KEY_ID=
MUSICKIT_P8_PATH=
# MUSICKIT_TOKEN_TTL_SECONDS=10368000
MUSICKIT_DEVELOPER_TOKEN=

# Detached GPG artifact signatures. GPG_KEY_ID is recommended when more than one
# secret key is installed. Leave GPG_PASSPHRASE blank to use the local gpg-agent;
# set it only in encrypted CI secrets for non-interactive signing.
GPG_KEY_ID=
GPG_PASSPHRASE=

# Tauri updater signing, generated with `npm run tauri -- signer generate`.
# The private key and password are required for signed builds. The public key
# source of truth is plugins.updater.pubkey in src-tauri/tauri.conf.json.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode signing via Azure Artifact Signing (Public Trust).
# Once per Windows release VM (as Administrator), run: npm run setup:win:artifact-signing
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Optional exact signing cert Subject DN. When set, every signature check
# must match it. Example: CN=Your Name, O=Your Org, C=US
AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0

# Optional: mirror cleaned release/ artifacts to another folder after finalize step.
AFTER_PACK_LOC=

# Override repo owner/name (defaults to BurntToasters/Arlet)
# GH_REPO_OWNER=BurntToasters
# GH_REPO_NAME=Arlet
