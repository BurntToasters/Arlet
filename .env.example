# Arlet environment
# Copy to .env. Never commit real credentials, private keys, tokens, or passwords.
# Vite `root` is `src/`; `envDir` is this repository root so `.env` loads.

# MusicKit developer token (Apple ES256 JWT, not a Vite token). Generate from your
# Apple Developer Media Services key; never commit the .p8.
# Debug: `dotenv -e .env -- tauri dev` serves it to MusicKit at runtime.
# Release builds no longer embed it. The app fetches a signed copy from the hosted
# token file; `npm run token:publish` mints, signs, and publishes it.
# Not required for the unprivileged music.apple.com diagnostic webview.
#
# Optional mint inputs for `npm run phase0:mint-token`. The .p8 path must be
# absolute and outside this repository. The script writes MUSICKIT_DEVELOPER_TOKEN
# and never prints the JWT or private key.
MUSICKIT_TEAM_ID=
MUSICKIT_KEY_ID=
MUSICKIT_P8_PATH=
# Optional comma-separated origins for DEV tokens only. Leave blank on the
# release machine: Apple refuses library (/v1/me) requests from an
# origin-restricted token, so token:publish and the release preflight reject one. Both send the token to Apple's
# catalog API before release.
# MUSICKIT_TOKEN_ORIGINS=
# MUSICKIT_TOKEN_TTL_SECONDS=10368000
MUSICKIT_DEVELOPER_TOKEN=

# Hosted MusicKit token publishing (release machine only). `npm run token:publish`
# uploads the signed token file to DigitalOcean Spaces and flushes the CDN.
# Use a Spaces key limited to that bucket and a doctl token scoped to CDN only.
# doctl must be installed and authenticated (`doctl auth init`).
ARLET_TOKEN_SPACES_KEY=
ARLET_TOKEN_SPACES_SECRET=
ARLET_TOKEN_SPACES_BUCKET=
ARLET_TOKEN_SPACES_REGION=
# CDN endpoint ID from `doctl compute cdn list`.
ARLET_TOKEN_CDN_ID=

# Detached GPG artifact signatures. GPG_KEY_ID is recommended when more than one
# secret key is installed. Leave GPG_PASSPHRASE blank to use the local gpg-agent;
# set it only in encrypted CI secrets for non-interactive signing.
GPG_KEY_ID=
# Full fingerprint of the release key. Release verification accepts
# SHA256SUMS.asc only from this key (falls back to GPG_KEY_ID when blank).
GPG_RELEASE_FINGERPRINT=
GPG_PASSPHRASE=

# Tauri updater signing, generated with `npm run tauri -- signer generate`.
# The private key and password are required for signed builds. The public key
# source of truth is plugins.updater.pubkey in src-tauri/tauri.conf.json.
TAURI_SIGNING_PRIVATE_KEY=
TAURI_SIGNING_PRIVATE_KEY_PASSWORD=

# Windows Authenticode signing via Azure Artifact Signing (Public Trust).
# Once per Windows release VM (as Administrator), run: npm run setup:win:artifact-signing
# AZURE_CLIENT_SECRET is secret; never commit real credentials.
AZURE_CLIENT_ID=
AZURE_TENANT_ID=
AZURE_SUBSCRIPTION_ID=
AZURE_CLIENT_SECRET=
AZURE_ARTIFACT_SIGNING_ENDPOINT=
AZURE_ARTIFACT_SIGNING_ACCOUNT=
AZURE_ARTIFACT_SIGNING_PROFILE=
AZURE_ARTIFACT_SIGNING_PUBLISHER=
# Required exact signing cert Subject DN. Every signature check must match it.
# Copy the Subject from a signed Arlet binary, or from the Azure profile.
# Example: CN=Your Name, O=Your Org, C=US
AZURE_ARTIFACT_SIGNING_PUBLISHER_DN=
# Optional overrides if the Client Tools are installed in a nonstandard path.
# AZURE_ARTIFACT_SIGNING_SIGNTOOL_PATH=
# AZURE_ARTIFACT_SIGNING_DLIB_PATH=
# Only the exact value 1 permits an unsigned Windows build; missing or 0 enforces signing.
SKIP_WIN_CODESIGN=0

# Optional: mirror cleaned release/ artifacts to another folder after finalize step.
AFTER_PACK_LOC=

# Override repo owner/name (defaults to BurntToasters/Arlet)
# GH_REPO_OWNER=BurntToasters
# GH_REPO_NAME=Arlet
